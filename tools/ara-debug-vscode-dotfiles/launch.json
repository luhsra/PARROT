{
    "version": "0.2.0",
    "configurations": [
        // ARA VSCode Debug configuration
        // Create symlink with: ln tools/ara-debug-vscode-dotfiles/launch.json vscode/.
        // Usually ARA is started with ninja+meson, use the -v flag to copy the used python command and insert its args here. 
        // HyperSSE step-settings need to be generated by running the ninja cmd once.
        {
            // Template Debug C++ in ARA
            "type": "cppdbg",
            "request": "launch",
            "name": "C++ Debugger: ARA XEN",
            "cwd": "${workspaceRoot}/build/",
            "program": "/usr/bin/python3",
            "additionalSOLibSearchPath": "${workspaceRoot}/build/subprojects/ara/ara/steps/native/step.cpython-310-x86_64-linux-gnu.so",
            "args": [
                "subprojects/ara/ara.py", "ignored", "--os", "XEN", "--log-level", "warn",
                // First generate step-settings with: ninja subprojects/ara/appl/Xen/hc-autosar
                "--step-settings", "subprojects/ara/appl/Xen/hypersse-hc-autosar.json"
            ],
            "miDebuggerPath": "/usr/bin/gdb"
            // , "preLaunchTask": "Ninja all"
        },
        {
            // Template Debug Python in ARA for Xen Apps
            "name": "Python Debugger: ARA XEN",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/",
            "program": "subprojects/ara/ara.py",
            "justMyCode": false,
            "console": "integratedTerminal",
            "args": [
                "ignored", "--os", "XEN", "--log-level", "warn",
                // First generate step-settings with: ninja subprojects/ara/appl/Xen/hc-autosar
                "--step-settings", "subprojects/ara/appl/Xen/hypersse-hc-autosar.json"
            ]
            // , "preLaunchTask": "Ninja all"
        },
        {
            // Template Debug Python in ARA for Autosar Apps
            "name": "Python Debugger: ARA Autosar",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/",
            "program": "subprojects/ara/ara.py",
            "justMyCode": false,
            "console": "integratedTerminal",
            "args": [
                "subprojects/ara/appl/AUTOSAR/autosar_singlecore_examples_ara_pointer.pi4.ll",
                "--os", "AUTOSAR", "--log-level", "warn",
                "--oilfile", "../subprojects/ara/appl/AUTOSAR/singlecore/examples/ara-pointer.json",
                "--step-settings", "../subprojects/ara/settings/autosar_generator_arm.json",
                "--ir_output", "subprojects/ara/appl/AUTOSAR/autosar_singlecore_examples_ara_pointer_noopt_mod.pi4.ll",
                "--generator_output", "subprojects/ara/appl/AUTOSAR/autosar_singlecore_examples_ara_pointer_noopt_autosar.pi4.cc",
                "--timing", "BB"
            ]
            // , "preLaunchTask": "Ninja all"
        }
    ]
}