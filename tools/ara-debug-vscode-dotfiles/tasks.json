{
    // Adds automatic ninja tasks that are autostarted before Debugconfigs from launch.json:
    // Create symlink with: ln tools/ara-debug-vscode-dotfiles/tasks.json vscode/.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Ninja Xen Single Core",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "${workspaceFolder}/build",
                "ara@@run_autosar_singlecore_xen_single_core_noopt_pi4",
                "-j", "10"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Ninja Xen Multi Core",
            "type": "shell",
            "command": "ninja",
            "args": [
