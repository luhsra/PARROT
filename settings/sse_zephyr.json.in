{
	"steps": [
	],

	"SIA": {
		"dump": false
	},
	
	"SSE": {
		"dump": true
	},
	
	"ReduceSSTG": {
		"dump": true
	},

	"ZephyrStatic": {
		"log_level": "debug"
	},

	"ZephyrStaticPost": {
		"kconfigfile": "@kconfig_file@"
	},
	
	"LoadKernelLL": {
		"kernel_ll": "@kernel_ll_file@"
	},

	"logger": {
		"StepManager": "info",
		"Zephyr": "debug",
		"ara": "info"
	},
	
	"RemoveSysfuncBody": {
		"drop_llvm_suffix": true,
		"disable": false
	},
	
	"IRWriter": {
		"ir_file": "sse_zephyr.ll"
	}
}
