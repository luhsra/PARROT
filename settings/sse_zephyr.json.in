{
	"steps": [
		"MergeStructs",
		"RemoveSysfuncBody",
		"ZephyrThreadEntry",
		"IRWriter",
		"SIA",
		"IRWriter",
		"LoadKernelLL",
		"SSE",
		"ReduceSSTG",
		"MultiSSE",
		"MSTGStats",
		"DumpCFG",
		"DumpInstances"
	],

	"SSE": {
		"dump": true
	},

	"MultiSSE": {
		"with_times": true,
		"dump": true
	},
	
	"SIA": {
		"dump": false
	},

	"MSTGStats": {
		"dump": true
	},

	"ReduceSSTG": {
		"dump": true
	},

	"ZephyrStatic": {
		"log_level": "info"
	},

	"ZephyrStaticPost": {
		"kconfigfile": "@kconfig_file@"
	},
	
	"LoadKernelLL": {
		"kernel_ll": "@kernel_ll_file@"
	},

	"logger": {
		"StepManager": "info",
		"Zephyr": "info",
		"ara": "info"
	},
	
	"RemoveSysfuncBody": {
		"drop_llvm_suffix": true,
		"disable": false
	},
	
	"IRWriter": {
		"ir_file": "sse_zephyr.ll"
	}
}
